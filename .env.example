NODE_ENV=development
PORT=3000

# Security
# Generate using: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars

# API Keys
# Required for Gemini AI API calls (set in runtime secrets when used in cloud)
GEMINI_API_KEY=your_gemini_api_key_here

# App URL (used for callbacks and signed links)
APP_URL=http://localhost:3000

# Database
DATABASE_URL=database.sqlite

# CORS
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:3000

# Email (SMTP) Configuration
# For Gmail: host=smtp.gmail.com, port=465, user=your_email, pass=app_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@schoolsync.edu

# Optional Testing
AUTO_VERIFY=false
